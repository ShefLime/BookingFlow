      SELECT "o"."Id", "o"."Name", "o"."Type", "o"."Description", "o"."TimeZone", "o"."Address", "o"."City", "o"."Phone", "o"."Email", "o"."WebsiteUrl", "o"."LogoImageUrl", "o"."CoverImageUrl", "o"."GalleryJson", "o"."DocumentsJson", "o"."ContentJson", "o"."IsActive", (
          SELECT COUNT(*)
          FROM "Resources" AS "r"
          WHERE "o"."Id" = "r"."OrganizationId" AND "r"."IsActive"), (
          SELECT COUNT(*)
          FROM "EventSessions" AS "e"
          WHERE "o"."Id" = "e"."OrganizationId" AND "e"."IsActive")
      FROM "Organizations" AS "o"
      WHERE "o"."IsActive"
      ORDER BY "o"."Name"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@__organizationId_0='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT EXISTS (
          SELECT 1
          FROM "Organizations" AS "o"
          WHERE "o"."Id" = @__organizationId_0)
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@__organizationId_0='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT "e"."Id", "e"."OrganizationId", "o"."Name", "e"."Name", "e"."Description", "e"."Location", "e"."PosterImageUrl", "e"."GalleryJson", "e"."DocumentsJson", "e"."ContentJson", "e"."StartAtUtc", "e"."EndAtUtc", "e"."Capacity", "e"."Capacity" - COALESCE((
          SELECT COALESCE(SUM("b"."GuestCount"), 0)
          FROM "Bookings" AS "b"
          WHERE "e"."Id" = "b"."EventSessionId" AND "b"."Status" NOT IN (3, 5)), 0), "e"."IsActive"
      FROM "EventSessions" AS "e"
      INNER JOIN "Organizations" AS "o" ON "e"."OrganizationId" = "o"."Id"
      WHERE "e"."OrganizationId" = @__organizationId_0 AND "e"."IsActive"

