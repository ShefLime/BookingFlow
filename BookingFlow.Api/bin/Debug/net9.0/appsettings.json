{
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bookingflow;Username=bookingflow;Password=bookingflow_dev_password"
  },
  "Storage": {
    "Provider": "Minio",
    "ServiceUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "AccessKey": "bookingflow",
    "SecretKey": "bookingflow-secret",
    "BucketName": "bookingflow-media",
    "PublicBaseUrl": "http://localhost:9000/bookingflow-media",
    "ForcePathStyle": true
  },
  "Jwt": {
    "Issuer": "BookingFlow.Api",
    "Audience": "BookingFlow.Client",
    "SigningKey": "bookingflow-dev-signing-key-please-change",
    "ExpirationMinutes": 720
  },
  "Keycloak": {
    "Realm": "bookingflow",
    "Authority": "http://localhost:8081/realms/bookingflow",
    "MetadataAddress": "http://localhost:8081/realms/bookingflow/.well-known/openid-configuration",
    "FrontendClientId": "bookingflow-frontend",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
